{
  "openapi": "3.0.1",
  "info": {
    "title": "GLMS.API.",
    "version": "1.0"
  },
  "paths": {
    "/api/contracts": {
      "get": {
        "tags": [
          "ContractsApi"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ContractStatus"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "ContractsApi"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Contract"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Contract"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Contract"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/contracts/{id}/status": {
      "patch": {
        "tags": [
          "ContractsApi"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContractStatus"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ContractStatus"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ContractStatus"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/contracts/{id}/requests": {
      "post": {
        "tags": [
          "ContractsApi"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestInputModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestInputModel"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RequestInputModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Client": {
        "required": [
          "contactDetails",
          "name",
          "region"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "contactDetails": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "region": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "contracts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Contract"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Contract": {
        "required": [
          "clientId",
          "endDate",
          "serviceLevel",
          "startDate",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "clientId": {
            "type": "integer",
            "format": "int32"
          },
          "client": {
            "$ref": "#/components/schemas/Client"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/ContractStatus"
          },
          "serviceLevel": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "signedAgreementPath": {
            "type": "string",
            "nullable": true
          },
          "serviceRequests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceRequest"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ContractStatus": {
        "enum": [
          0,
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      },
      "RequestInputModel": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "nullable": true
          },
          "costInUSD": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "ServiceRequest": {
        "required": [
          "contractId",
          "costInUSD",
          "costInZAR",
          "description",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "contractId": {
            "type": "integer",
            "format": "int32"
          },
          "contract": {
            "$ref": "#/components/schemas/Contract"
          },
          "description": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "costInUSD": {
            "type": "number",
            "format": "double"
          },
          "costInZAR": {
            "type": "number",
            "format": "double"
          },
          "status": {
            "$ref": "#/components/schemas/ServiceStatus"
          }
        },
        "additionalProperties": false
      },
      "ServiceStatus": {
        "enum": [
          0,
          1,
          2,
          3
        ],
        "type": "integer",
        "format": "int32"
      }
    }
  }
}